rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }

    function isOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function isInvited(data) {
      return signedInEmail() != ''
        && data.invitedEmails is list
        && signedInEmail() in data.invitedEmails;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && householdId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.get('invitedEmails', []) == [];

      allow read: if isMember(resource.data)
        || isInvited(resource.data)
        || (signedIn() && householdId == request.auth.uid);

      allow update: if request.resource.data.ownerId == resource.data.ownerId
        && (
          (
            isMember(resource.data)
            && request.resource.data.memberIds == resource.data.memberIds
            && (
              request.resource.data.get('invitedEmails', []) == resource.data.get('invitedEmails', [])
              || isOwner(resource.data)
            )
          )
          || (
            isInvited(resource.data)
            && !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.get('invitedEmails', []).size() == resource.data.invitedEmails.size() - 1
            && !(signedInEmail() in request.resource.data.get('invitedEmails', []))
            && resource.data.invitedEmails.hasAll(request.resource.data.get('invitedEmails', []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'memberIds', 'invitedEmails', 'updatedAt', 'updatedBy'
            ])
          )
        );

      allow delete: if isOwner(resource.data);
    }

    match /householdInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == request.auth.uid;

      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.inviteeEmail == signedInEmail());

      allow update: if signedIn()
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && (
          resource.data.ownerId == request.auth.uid
          || (
            resource.data.inviteeEmail == signedInEmail()
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'acceptedBy', 'acceptedAt'
            ])
          )
        );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
